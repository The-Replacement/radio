# Private radio — configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env

# Address Caddy serves on.
#  - Local test:  http://localhost   (listens on the container's :80, which the
#                                      compose publishes on the host's 8090)
#  - Production:  stream.daza.ar   (tunnel; the page lives on Cloudflare
#                                      Pages — see FRONTEND_URL)
SITE_ADDRESS=http://localhost

# The frontend's URL (the page, no door). The exchange uses it as the
# redirect's destination and CORS as the allowed origin. In production it is
# Cloudflare Pages; locally this same Caddy serves it too.
#   - Production:    FRONTEND_URL=https://comechingona.daza.ar
#   - Local:         FRONTEND_URL=http://localhost:8090 (the default)
# CAREFUL: no trailing slash — it is inserted as-is into CORS and the Location.
FRONTEND_URL=http://localhost:8090

# The URL you give people. Different from SITE_ADDRESS: here the port seen from
# outside does go. token.sh uses it to print the link.
PUBLIC_URL=http://localhost:8090

# The session cookie's flags. The browser receives it when the invitation link
# is opened and from then on the token no longer travels in the URL.
#
#   Local (http):        HttpOnly; SameSite=Lax
#   Production (https):  HttpOnly; SameSite=Lax; Secure
#
# The `Secure` flag makes the browser send the cookie only over HTTPS.
# If you test in the browser against http://localhost and cannot get in, this is
# it: remove the `; Secure`.
COOKIE_FLAGS=HttpOnly; SameSite=Lax

# Email for Let's Encrypt. Optional: only used if you uncomment the
# `email {$ACME_EMAIL}` line in caddy/Caddyfile. Leaving it as is breaks nothing.
ACME_EMAIL=tu@email.com

# Ports published on the host
HTTP_PORT=8090
HTTPS_PORT=8443

# Camera (optional). The compose uses the FaceCam's stable symlink.
# It is by-id and not /dev/videoN on purpose: the number changes depending on the
# order the kernel enumerates cameras. For another webcam:
#   ls -l /dev/v4l/by-id/
# If you do not want a camera, delete the `cam` service from docker-compose.yml.
CAM_DEVICE=/dev/v4l/by-id/usb-KYE_Systems_Corp._FaceCam_1000X-video-index0

# The WebRTC video's UDP port. It goes outside Caddy on purpose (that is the
# price of <1s) and that is why it is tied to 127.0.0.1: this machine only.
# To watch it from the LAN: put "8189:8189/udp" here in docker-compose.yml, add
# this machine's IP to webrtcAdditionalHosts in mediamtx/mediamtx.yml, and open
# the port on the firewall.
WEBRTC_UDP_PORT=8189

# indiegenerator: generates the music and replaces ./music on every cycle.
# The build context is the indiegenerator repo on the mainframe.
INDIEGEN_CONTEXT=../indiegenerator
INDIEGEN_PRESET=station
INDIEGEN_COUNT=10
INDIEGEN_SEED_BASE=1000
# uid/gid of the host user who owns ./music and ./data/indiegen. The container
# runs as that user instead of root, so what it writes does not end up root:root
# (if it did, any rewrite from the host gives EACCES). Get them with `id -u` /
# `id -g` on the box; it is mandatory, the compose does not start without them.
INDIEGEN_UID=1000
INDIEGEN_GID=1000
# advance = new seeds every cycle; time = derived from the clock; fixed = fixed.
INDIEGEN_SEED_STRATEGY=advance
# Seconds between cycles (21600 = 6 h). A push to indiegenerator can also
# trigger an immediate cycle by touching data/indiegen/trigger.
INDIEGEN_INTERVAL_SECONDS=21600
# 1 = every push to indiegenerator rebuilds the container AND rotates the
# library (full render, ~7 min of CPU + liquidsoap restart + ~10 s of cut).
# 0 = the push only deploys code and the content rotates by interval or by hand
# (scripts/indiegen-cycle.sh). The post-receive in ~/servers/indiegenerator reads
# it on every push: changing it does not require reinstalling the hook.
# Careful: a push is a code change; rotating the library over a comment is
# expensive — 1 is deliberate, not a new deployment's default.
INDIEGEN_AUTO_TRIGGER=1
# Restart liquidsoap when the library rotates (necessary: liquidsoap's watch
# does not forget deletions). signal:<path> = the generator writes a file and a
# host watcher (cron + scripts/restart-on-signal.sh) runs the `docker compose
# restart liquidsoap`. No /var/run/docker.sock in ANY container: the socket in
# the generator was root-equivalent over the whole host. The path is INTERNAL to
# the container (volume ./data/indiegen → /var/lib/indiegen).
INDIEGEN_RESTART=signal:/var/lib/indiegen/restart-request

# Icecast secrets. Generate your own:
#   openssl rand -hex 24
ICECAST_SOURCE_PASSWORD=change_this_for_a_random_one
ICECAST_RELAY_PASSWORD=change_this_for_a_random_one
ICECAST_ADMIN_PASSWORD=change_this_for_a_random_one

# Mario (the host voice): deterministic TTS generator, fused into this repo
# (src/mario/, presets/, Dockerfile.mario). Runs as a container, mirroring
# indiegenerator: built from the repo root and invoked on demand by the
# watcher (scripts/restart-on-signal.sh) and an hourly cron
# (scripts/mario-refresh.sh). Output lands in ./data/host.
#
# Default: Kokoro backend + Spanish female voice ef_dora (sexy female tone as
# requested). Requires local Kokoro model/voices files mounted read-only (see
# docker-compose.yml and docs/MARIO.md). Piper remains supported as an
# alternative backend (e.g. es_AR-daniela-high for Argentine accent).
MARIO_MODEL=/models/kokoro/kokoro-v1.0.onnx
MARIO_VOICES_PATH=/models/kokoro/voices-v1.0.bin
MARIO_VOICE=ef_dora
MARIO_TIME_BUCKET_HOURS=1
MARIO_MODEL_LANG=es
MARIO_TEMPLATE_VERSION=mario/2
