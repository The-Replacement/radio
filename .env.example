# Radio privada — configuración
# Copiá este archivo a .env y completá los valores.
# NUNCA commitees .env

# Dirección donde Caddy sirve.
#  - Prueba local:  http://localhost   (escucha en el :80 del contenedor,
#                                      que el compose publica en el 8090 del host)
#  - Producción:    radio.daza.ar      (requiere DNS apuntando a este host, DNS-ONLY en Cloudflare)
SITE_ADDRESS=http://localhost

# URL que le pasás a la gente. Distinta de SITE_ADDRESS: acá sí va el puerto
# que se ve desde afuera. token.sh la usa para imprimir el link.
PUBLIC_URL=http://localhost:8090

# Flags de la cookie de sesión. El navegador la recibe al abrir el link
# de invitación y a partir de ahí el token no vuelve a viajar en la URL.
#
#   Local (http):        HttpOnly; SameSite=Lax
#   Producción (https):  HttpOnly; SameSite=Lax; Secure
#
# El flag `Secure` hace que el navegador solo mande la cookie por HTTPS.
# Si probás en el navegador contra http://localhost y no entrás, es esto:
# sacale el `; Secure`.
COOKIE_FLAGS=HttpOnly; SameSite=Lax

# Email para Let's Encrypt. Opcional: solo se usa si descomentás la línea
# `email {$ACME_EMAIL}` en caddy/Caddyfile. Dejarlo así no rompe nada.
ACME_EMAIL=tu@email.com

# Puertos publicados en el host
HTTP_PORT=8090
HTTPS_PORT=8443

# Cámara (opcional). El compose usa el symlink estable de la FaceCam.
# Es by-id y no /dev/videoN a propósito: el número cambia según el orden en
# que el kernel enumera las cámaras. Para otro webcam:
#   ls -l /dev/v4l/by-id/
# Si no querés cámara, borrá el servicio `cam` del docker-compose.yml.
CAM_DEVICE=/dev/v4l/by-id/usb-KYE_Systems_Corp._FaceCam_1000X-video-index0

# Puerto UDP del video WebRTC. Va por fuera de Caddy a propósito (es el precio
# de <1s) y por eso está atado a 127.0.0.1: sólo esta máquina.
# Para verlo desde la LAN: acá "8189:8189/udp" en docker-compose.yml, agregar
# la IP de esta máquina a webrtcAdditionalHosts en mediamtx/mediamtx.yml, y
# abrir el puerto en el firewall.
WEBRTC_UDP_PORT=8189

# Secretos de Icecast. Generá los tuyos:
#   openssl rand -hex 24
ICECAST_SOURCE_PASSWORD=cambiar_esto_por_uno_aleatorio
ICECAST_RELAY_PASSWORD=cambiar_esto_por_uno_aleatorio
ICECAST_ADMIN_PASSWORD=cambiar_esto_por_uno_aleatorio
