#!/bin/sh
# post-receive — runs ON the box that serves the radio, after every push.
#
# git updates the working tree by itself (this repo uses
# receive.denyCurrentBranch=updateInstead, so the push fast-forwards the
# local tree). There is therefore NO fetch, NO pull and NO credentials here:
# the push IS the synchronization. The process ends with the working tree at
# the pushed commit, and this hook decides what actually changes, live.
#
# What it touches, and what it NEVER touches:
#   - caddy/Caddyfile or caddy/tokens.caddy changed -> `caddy reload` inside
#     the container: graceful reload, listeners are not cut.
#   - src/, presets/, pyproject.toml, uv.lock, Dockerfile.mario or
#     docker-compose.yml changed -> `docker compose build mario`: rebuilds the
#     radio-mario image. It does not cut the stream (it is an image, not a
#     Liquidsoap restart); the next hourly cycle (mario-refresh.sh) uses it.
#   - everything else: only logged. web/ is deployed by Pages; cam, liquidsoap
#     and mediamtx are NOT restarted by a push — restarting Liquidsoap cuts
#     the stream, and that is a human decision.
#
# Everything is recorded in data/deploy.log (gitignored). If the reload or the
# build fails, it writes a complaint to the log and exits 1 — the push still
# lands (it was already written) and the previous config/image keep serving.
set -u

# Under a receive hook the cwd IS the git dir (not the worktree): with
# --show-toplevel the resolution lands on .git and the hook writes/reloads in
# the wrong place. The .. of the git dir is the worktree in a normal clone.
RAIZ="$(cd "$(git rev-parse --git-dir)/.." && pwd)"
# Odd layouts (bare, linked worktrees): fall back to the toplevel, and if that
# returns the git dir, keep pwd as the last resort.
[ -f "$RAIZ/docker-compose.yml" ] || {
  ALT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$ALT" ] && [ -f "$ALT/docker-compose.yml" ] && RAIZ="$ALT"
}
LOG="$RAIZ/data/deploy.log"
mkdir -p "$RAIZ/data"
log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG"; }

while read -r OLD NEW REF; do
  [ "$REF" = "refs/heads/master" ] || continue
  log "push received ${OLD}..${NEW}"
  # A detached HEAD cannot be moved by receive.denyCurrentBranch=updateInstead:
  # the push updates the ref, the worktree stays where it was, and this hook
  # then rebuilds images from STALE code while logging success. That happened on
  # 2026-11-13 and went unnoticed for hours. Fail loudly instead (#107).
  if ! git symbolic-ref -q HEAD >/dev/null 2>&1; then
    log "FAIL: HEAD is detached; updateInstead cannot move the worktree. Deploy did nothing."
    exit 1
  fi
  # Remote-tracking refs must come from GitHub fetches, never from a deploy push.
  # If the diff fails there is nothing to read: that is not green, it is a
  # false alarm — the reload cannot depend on a comparison that never
  # happened. Stop loudly.
  CHANGES="$(git diff --name-only "$OLD" "$NEW")" || {
    log "FAIL: could not compare $OLD..$NEW — nothing was touched"
    exit 1
  }
  if [ -n "$CHANGES" ]; then
    printf '%s\n' "$CHANGES" | sed 's/^/         /' >> "$LOG"
  fi
  if printf '%s\n' "$CHANGES" | grep -qE '^caddy/(Caddyfile|tokens\.caddy)$'; then
    if docker compose -f "$RAIZ/docker-compose.yml" exec -T caddy \
         caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
      log "caddy reloaded live (Caddyfile/tokens.caddy) — listeners intact"
    else
      log "FAIL: caddy reload did not take; the previous config keeps serving"
      exit 1
    fi
  else
    log "no Caddyfile/tokens.caddy changes: nothing to reload"
  fi

  # Rebuild radio-mario if the push touched code, presets or dependencies.
  if printf '%s\n' "$CHANGES" | grep -qE '^(src/|presets/|pyproject\.toml$|uv\.lock$|Dockerfile\.mario$|docker-compose\.yml$)'; then
    log "mario: changes detected, rebuilding the radio-mario image"
    build_start=$(date +%s)
    if docker compose -f "$RAIZ/docker-compose.yml" build mario >> "$LOG" 2>&1; then
      build_dur=$(( $(date +%s) - build_start ))
      log "mario: build OK in ${build_dur}s — the next hourly cycle uses the new code"
    else
      build_dur=$(( $(date +%s) - build_start ))
      log "FAIL: mario build failed after ${build_dur}s; the previous image is still in place"
      exit 1
    fi
  else
    log "mario: no code/preset/dependency changes; not rebuilding"
  fi

  # Rebuild radio-cam if its image or entrypoint changed. It does not start the
  # service: there may be no device, and the operator decides when to bring it up.
  if printf '%s\n' "$CHANGES" | grep -qE '^(cam/|docker-compose\.yml$)'; then
    log "cam: changes detected, rebuilding the radio-cam image"
    build_start=$(date +%s)
    if docker compose -f "$RAIZ/docker-compose.yml" build cam >> "$LOG" 2>&1; then
      build_dur=$(( $(date +%s) - build_start ))
      log "cam: build OK in ${build_dur}s"
    else
      build_dur=$(( $(date +%s) - build_start ))
      log "FAIL: cam build failed after ${build_dur}s; the previous image is still in place"
      exit 1
    fi
  else
    log "cam: no image changes; not rebuilding"
  fi

  # Best-effort ownership repair for hardened non-root bind mounts (#83).
  # Effective only when scoped passwordless sudo is wired for this fixed script.
  if [ -x "$RAIZ/scripts/fix-data-ownership.sh" ]; then
    if sudo -n true 2>/dev/null; then
      sudo -n "$RAIZ/scripts/fix-data-ownership.sh" >> "$LOG" 2>&1 \
        || log "WARN: ownership repair failed"
    else
      log "note: ownership repair skipped (no passwordless sudo)"
    fi
  fi
done
log "deploy ready"
exit 0
