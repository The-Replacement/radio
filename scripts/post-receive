#!/bin/sh
# post-receive — corre EN el box que sirve la radio, después de cada push.
#
# git actualiza el working tree solo (con receive.denyCurrentBranch=
# updateInstead en este repo, el push fast-forwardea el árbol local), así
# que acá NO hay fetch, ni pull, ni credenciales: el push es la
# sincronización. El proceso acaba con la working tree en el commit
# empujado y este hook decide qué, en caliente, cambia de verdad.
#
# Qué toca, y qué NUNCA toca:
#   - caddy/Caddyfile o caddy/tokens.caddy cambiaron -> `caddy reload`
#     adentro del contenedor: reload graceful, sin cortar a los oyentes.
#   - src/, presets/, pyproject.toml, uv.lock, Dockerfile.mario o
#     docker-compose.yml cambiaron -> `docker compose build mario`: reconstruye
#     la imagen radio-mario. No corta el stream (es una imagen, no un restart
#     de Liquidsoap); el próximo ciclo horario (mario-refresh.sh) la usa.
#   - todo lo demás: sólo se registra. web/ la despliega Pages; cam,
#     liquidsoap y mediamtx NO se reinician por un push — reiniciar
#     Liquidsoap corta el stream, y eso es una decisión humana.
#
# Registra todo en data/deploy.log (gitignored). Si el reload o el build
# fallan, abre un reclamo en el log y sale 1 — el push llega igual (ya estaba
# escrito) y la config/imagen anterior siguen en pie.
set -u

# Bajo un receive hook, el cwd ES el git dir (no el worktree): con
# --show-toplevel la resolución da .git y el hook escribe/recarga en
# el lugar equivocado. El .. del git dir es el worktree en un clone normal.
RAIZ="$(cd "$(git rev-parse --git-dir)/.." && pwd)"
# Layouts raros (bare, worktrees ligados): cae al toplevel, y si éste
# devuelve el git dir, se queda con pwd como último recurso.
[ -f "$RAIZ/docker-compose.yml" ] || {
  ALT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$ALT" ] && [ -f "$ALT/docker-compose.yml" ] && RAIZ="$ALT"
}
LOG="$RAIZ/data/deploy.log"
mkdir -p "$RAIZ/data"
log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG"; }

while read -r OLD NEW REF; do
  [ "$REF" = "refs/heads/master" ] || continue
  log "push recibido ${OLD}..${NEW}"
  # La caja no puede fetch (no tiene credenciales de GitHub), así que su
  # refs/remotes/origin/master queda congelado y `git status` mentía
  # "ahead N". El push ES la sincronización: apuntar el ref al commit que
  # acaba de llegar deja el status honesto ("up to date").
  git update-ref refs/remotes/origin/master "$NEW" 2>/dev/null || true
  # Si el diff falla, no hay cambios que leer: eso NO es verde, es
  # falsa alarma — el reload no puede depender de una comparación
  # que no se hizo. Se frena ruidoso.
  CAMBIOS="$(git diff --name-only "$OLD" "$NEW")" || {
    log "FALLO: no pude comparar $OLD..$NEW — no se tocó nada"
    exit 1
  }
  if [ -n "$CAMBIOS" ]; then
    printf '%s\n' "$CAMBIOS" | sed 's/^/         /' >> "$LOG"
  fi
  if printf '%s\n' "$CAMBIOS" | grep -qE '^caddy/(Caddyfile|tokens\.caddy)$'; then
    if docker compose -f "$RAIZ/docker-compose.yml" exec -T caddy \
         caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
      log "caddy recargó en caliente (Caddyfile/tokens.caddy) — oyentes intactos"
    else
      log "FALLO: caddy reload no cuajó; la config anterior sigue sirviendo"
      exit 1
    fi
  else
    log "sin cambios de Caddyfile/tokens.caddy: nada que recargar"
  fi

  # Rebuild radio-mario si el push tocó código, presets o dependencias.
  if printf '%s\n' "$CAMBIOS" | grep -qE '^(src/|presets/|pyproject\.toml$|uv\.lock$|Dockerfile\.mario$|docker-compose\.yml$)'; then
    log "mario: cambios detectados, reconstruyendo imagen radio-mario"
    build_start=$(date +%s)
    if docker compose -f "$RAIZ/docker-compose.yml" build mario >> "$LOG" 2>&1; then
      build_dur=$(( $(date +%s) - build_start ))
      log "mario: build OK en ${build_dur}s — próximo ciclo horario usa el código nuevo"
    else
      build_dur=$(( $(date +%s) - build_start ))
      log "FALLO: mario build falló tras ${build_dur}s; la imagen anterior sigue en pie"
      exit 1
    fi
  else
    log "mario: sin cambios de código/presets/deps; no se reconstruye"
  fi

  # Rebuild radio-cam si cambió su imagen/entrypoint. No arranca el servicio:
  # puede no haber dispositivo; el operador decide cuándo levantarlo.
  if printf '%s\n' "$CAMBIOS" | grep -qE '^(cam/|docker-compose\.yml$)'; then
    log "cam: cambios detectados, reconstruyendo imagen radio-cam"
    build_start=$(date +%s)
    if docker compose -f "$RAIZ/docker-compose.yml" build cam >> "$LOG" 2>&1; then
      build_dur=$(( $(date +%s) - build_start ))
      log "cam: build OK en ${build_dur}s"
    else
      build_dur=$(( $(date +%s) - build_start ))
      log "FALLO: cam build falló tras ${build_dur}s; la imagen anterior sigue en pie"
      exit 1
    fi
  else
    log "cam: sin cambios de imagen; no se reconstruye"
  fi

  # Best-effort ownership repair for hardened non-root bind mounts (#83).
  # Effective only when scoped passwordless sudo is wired for this fixed script.
  if [ -x "$RAIZ/scripts/fix-data-ownership.sh" ]; then
    sudo -n "$RAIZ/scripts/fix-data-ownership.sh" >> "$LOG" 2>&1 || true
  fi
done
log "deploy listo"
exit 0