#!/bin/sh
# post-receive — runs ON the box that serves the radio, after every push.
#
# git updates the working tree by itself (this repo uses
# receive.denyCurrentBranch=updateInstead, so the push fast-forwards the
# local tree). There is therefore NO fetch, NO pull and NO credentials here:
# the push IS the synchronization. The process ends with the working tree at
# the pushed commit, and this hook decides what actually changes, live.
#
# What it touches, and what it NEVER touches:
#   - caddy/Caddyfile or caddy/tokens.caddy changed -> `caddy reload` inside
#     the container: graceful reload, listeners are not cut.
#   - src/, presets/, pyproject.toml, uv.lock, Dockerfile.mario or
#     docker-compose.yml changed -> `docker compose build mario`: rebuilds the
#     radio-mario image. It does not cut the stream (it is an image, not a
#     Liquidsoap restart); the next hourly cycle (mario-refresh.sh) uses it.
#   - everything else: only logged. web/ is deployed by Pages; cam, liquidsoap
#     and mediamtx are NOT restarted by a push — restarting Liquidsoap cuts
#     the stream, and that is a human decision.
#
# Everything is recorded in data/deploy.log (gitignored) and in the deployment
# manifest (data/deploy-manifest.json, also gitignored): the log says what
# happened, the manifest says what is running and where it came from. If the
# reload or the build fails, it writes a complaint to the log, records the
# failed deploy in the manifest and exits 1 — the push still lands (it was
# already written) and the previous config/image keep serving.
set -u

# Under a receive hook the cwd IS the git dir (not the worktree): with
# --show-toplevel the resolution lands on .git and the hook writes/reloads in
# the wrong place. The .. of the git dir is the worktree in a normal clone.
RAIZ="$(cd "$(git rev-parse --git-dir)/.." && pwd)"
# Odd layouts (bare, linked worktrees): fall back to the toplevel, and if that
# returns the git dir, keep pwd as the last resort.
[ -f "$RAIZ/docker-compose.yml" ] || {
  ALT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [ -n "$ALT" ] && [ -f "$ALT/docker-compose.yml" ] && RAIZ="$ALT"
}
LOG="$RAIZ/data/deploy.log"
mkdir -p "$RAIZ/data"
log() { printf '[%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$LOG"; }

# The deployment manifest: the machine-readable record of what this deploy
# produced. The log says what happened; the manifest says which commit
# produced which image, so a running container can be traced to a source
# revision and a rollback has a target. A missing python3 must not break a
# deploy that already landed, so that is a warning; a manifest that fails to
# write is a failure of the evidence, and that one is loud.
manifest_write() {
  MANIFEST="$RAIZ/scripts/deploy_manifest.py"
  if [ ! -f "$MANIFEST" ]; then
    log "WARN: scripts/deploy_manifest.py is missing: this deploy is unrecorded"
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    log "WARN: python3 is not available: this deploy is unrecorded"
    return 0
  fi
  if python3 "$MANIFEST" record --root "$RAIZ" --ref "$REF" --old "$OLD" --new "$NEW" \
       --status "$1" --reason "$2" --rebuilt "$REBUILT" >> "$LOG" 2>&1; then
    log "manifest: written to data/deploy-manifest.json (status $1)"
    return 0
  fi
  log "FAIL: the deployment manifest could not be written: the deploy is unrecorded"
  return 1
}

while read -r OLD NEW REF; do
  case "$REF" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  REBUILT=""
  REASON="push ${OLD}..${NEW} to ${REF}"
  log "push received ${OLD}..${NEW} to ${REF}"
  # A detached HEAD cannot be moved by receive.denyCurrentBranch=updateInstead:
  # the push updates the ref, the worktree stays where it was, and this hook
  # then rebuilds images from STALE code while logging success. That happened on
  # 2026-11-13 and went unnoticed for hours. Fail loudly instead (#107).
  HEAD_REF="$(git symbolic-ref -q HEAD || true)"
  if [ -z "$HEAD_REF" ]; then
    log "FAIL: HEAD is detached; updateInstead cannot move the worktree. Deploy did nothing."
    manifest_write failed "$REASON; HEAD is detached"
    exit 1
  fi
  # updateInstead moves the worktree only when the pushed ref IS the branch
  # checked out here. Any other branch updates a ref nobody has: the worktree
  # keeps the previous commit while this hook rebuilds stale code and logs
  # success. This box checks out $HEAD_REF; a push to anything else is not a
  # deploy (infra#12).
  if [ "$REF" != "$HEAD_REF" ]; then
    log "FAIL: pushed $REF but HEAD is on $HEAD_REF; updateInstead would leave the worktree where it is. Push $HEAD_REF instead."
    manifest_write failed "$REASON; branch mismatch, HEAD is $HEAD_REF"
    exit 1
  fi
  # The worktree must actually be at the pushed commit: that is the tree the
  # containers mount, and the only commit this deploy is allowed to serve.
  WORKTREE_SHA="$(git rev-parse HEAD)"
  if [ "$WORKTREE_SHA" != "$NEW" ]; then
    log "FAIL: worktree is at $WORKTREE_SHA, not $NEW; refusing to deploy a tree that does not contain the push"
    manifest_write failed "$REASON; worktree at $WORKTREE_SHA, pushed $NEW"
    exit 1
  fi
  log "worktree moved to $WORKTREE_SHA"
  # Remote-tracking refs must come from GitHub fetches, never from a deploy push.
  # If the diff fails there is nothing to read: that is not green, it is a
  # false alarm — the reload cannot depend on a comparison that never
  # happened. Stop loudly.
  CHANGES="$(git diff --name-only "$OLD" "$NEW")" || {
    log "FAIL: could not compare $OLD..$NEW — nothing was touched"
    manifest_write failed "$REASON; could not compare $OLD..$NEW"
    exit 1
  }
  if [ -n "$CHANGES" ]; then
    printf '%s\n' "$CHANGES" | sed 's/^/         /' >> "$LOG"
  fi
  if printf '%s\n' "$CHANGES" | grep -qE '^caddy/(Caddyfile|tokens\.caddy)$'; then
    if docker compose -f "$RAIZ/docker-compose.yml" exec -T caddy \
         caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
      log "caddy reloaded live (Caddyfile/tokens.caddy) — listeners intact"
      REASON="$REASON; caddy reloaded"
    else
      log "FAIL: caddy reload did not take; the previous config keeps serving"
      manifest_write failed "$REASON; caddy reload failed"
      exit 1
    fi
  else
    log "no Caddyfile/tokens.caddy changes: nothing to reload"
  fi

  # The images carry the source revision they were built from (OCI labels),
  # so a running container can be traced to a commit. VCS_REF is the PUSHED
  # SHA, not the checkout's idea of it: that is the commit the manifest
  # records and the one the verification compares against.
  VCS_REF="$NEW"
  OCI_SOURCE="https://github.com/The-Replacement/radio"
  export VCS_REF OCI_SOURCE

  # Rebuild radio-mario if the push touched code, presets or dependencies.
  if printf '%s\n' "$CHANGES" | grep -qE '^(src/|presets/|pyproject\.toml$|uv\.lock$|Dockerfile\.mario$|docker-compose\.yml$)'; then
    log "mario: changes detected, rebuilding the radio-mario image"
    build_start=$(date +%s)
    if docker compose -f "$RAIZ/docker-compose.yml" build mario >> "$LOG" 2>&1; then
      build_dur=$(( $(date +%s) - build_start ))
      log "mario: build OK in ${build_dur}s — the next hourly cycle uses the new code"
      REBUILT="$REBUILT,mario"
      REASON="$REASON; mario rebuilt"
    else
      build_dur=$(( $(date +%s) - build_start ))
      log "FAIL: mario build failed after ${build_dur}s; the previous image is still in place"
      manifest_write failed "$REASON; mario build failed"
      exit 1
    fi
  else
    log "mario: no code/preset/dependency changes; not rebuilding"
  fi

  # Rebuild radio-cam if its image or entrypoint changed. It does not start the
  # service: there may be no device, and the operator decides when to bring it up.
  if printf '%s\n' "$CHANGES" | grep -qE '^(cam/|docker-compose\.yml$)'; then
    log "cam: changes detected, rebuilding the radio-cam image"
    build_start=$(date +%s)
    if docker compose -f "$RAIZ/docker-compose.yml" build cam >> "$LOG" 2>&1; then
      build_dur=$(( $(date +%s) - build_start ))
      log "cam: build OK in ${build_dur}s"
      REBUILT="$REBUILT,cam"
      REASON="$REASON; cam rebuilt"
    else
      build_dur=$(( $(date +%s) - build_start ))
      log "FAIL: cam build failed after ${build_dur}s; the previous image is still in place"
      manifest_write failed "$REASON; cam build failed"
      exit 1
    fi
  else
    log "cam: no image changes; not rebuilding"
  fi

  # Best-effort ownership repair for hardened non-root bind mounts (#83).
  # Effective only when scoped passwordless sudo is wired for this fixed script.
  if [ -x "$RAIZ/scripts/fix-data-ownership.sh" ]; then
    if sudo -n true 2>/dev/null; then
      # SC2024 wants the redirect to run under sudo. It must not: $LOG belongs to
      # the deploy user, and opening it BEFORE sudo is what stops root from
      # creating a root-owned log (the #83 class of problem this repairs). sudo
      # wraps the command; the redirect stays with the caller.
      # shellcheck disable=SC2024
      sudo -n "$RAIZ/scripts/fix-data-ownership.sh" >> "$LOG" 2>&1 \
        || log "WARN: ownership repair failed"
    else
      log "note: ownership repair skipped (no passwordless sudo)"
    fi
  fi

  # The evidence. Written last, so it describes the deploy that just
  # happened — the images on the box are the ones this push produced. A
  # deploy whose evidence cannot be written is not a green deploy: the push
  # lands, but the hook says so and fails.
  if ! manifest_write deployed "$REASON"; then
    exit 1
  fi
  DEPLOYED=1
done
# "deploy ready" is evidence, so it may only exist when something was actually
# deployed: a tag-only push must leave the log without it (infra#12).
if [ "${DEPLOYED:-0}" -eq 1 ]; then
  log "deploy ready"
fi
exit 0
