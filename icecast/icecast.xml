<?xml version="1.0"?>
<!--
  Icecast — radio privada.

  Dos decisiones que hacen a la privacidad:

  1. NO existe la sección <directory>. Icecast no se anuncia en NINGÚN
     directorio público (dir.xiph.org y similares). Es lo que hace que la
     radio no aparezca en los listados de radios de internet.

  2. <public>0</public> en el mount, como segunda barrera.

  Además: este contenedor no publica puertos. Solo Caddy lo alcanza.
-->
<icecast>
    <location>AR</location>
    <admin>admin@localhost</admin>

    <limits>
        <clients>40</clients>
        <sources>2</sources>
        <queue-size>524288</queue-size>
        <client-timeout>60</client-timeout>
        <header-timeout>30</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65536</burst-size>
    </limits>

    <authentication>
        <source-password>${ICECAST_SOURCE_PASSWORD}</source-password>
        <relay-password>${ICECAST_RELAY_PASSWORD}</relay-password>
        <admin-user>admin</admin-user>
        <admin-password>${ICECAST_ADMIN_PASSWORD}</admin-password>
    </authentication>

    <hostname>localhost</hostname>

    <listen-socket>
        <port>8000</port>
        <bind-address>0.0.0.0</bind-address>
    </listen-socket>

    <mount type="normal">
        <mount-name>/stream</mount-name>
        <public>0</public>
        <max-listeners>40</max-listeners>
        <max-listener-duration>0</max-listener-duration>
        <charset>UTF-8</charset>
    </mount>

    <!-- fileserve 0: sólo emitimos, no servimos archivos estáticos del
         webroot. Menos superficie y nada que lo justifique (el stream y
         el status son handlers, no archivos). -->
    <fileserve>0</fileserve>

    <paths>
        <basedir>/usr/share/icecast</basedir>
        <logdir>/var/log/icecast</logdir>
        <webroot>/usr/share/icecast/web</webroot>
        <adminroot>/usr/share/icecast/admin</adminroot>
    </paths>

    <logging>
        <!-- "-" = stdout/stderr. En Docker esto es lo correcto: los logs
             aparecen en `docker compose logs` y no chocan con los permisos
             de un bind-mount, que anula el chown de la imagen. -->
        <accesslog>-</accesslog>
        <errorlog>-</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
    </security>
</icecast>
