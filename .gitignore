# Secretos - NUNCA al repo
.env
secrets/
data/
logs/

# Nota: las dependencias de scripts/docs.sh NO van acá. Se instalan en
# el cache del usuario ($XDG_CACHE_HOME/radio-docs) para no meterle
# ~450 MB al proyecto.

# Tonos de prueba generados por el README
music/_prueba-*

# Biblioteca generada por indiegen (se reemplaza cada ciclo): NO va al repo.
music/*.flac
music/*.json
music/.tmp/

# Restos de herramientas
__pycache__/
.ruff_cache/

# El matcher generado. Contiene credenciales reales: NO va al repo.
caddy/tokens.caddy

# Archivos temporales del generador de matchers
caddy/tokens.caddy.nuevo
caddy/tokens.caddy.previo

# --- mario (paquete python) ---
.venv/
venv/
*.py[cod]
*.egg-info/
build/
dist/
