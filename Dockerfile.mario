# Mario — the host voice for the radio.
#
# Host-side install is the default (Approach A). This image is optional, for
# operators who prefer a container. It installs the Kokoro runtime; the TTS
# model/voices are mounted at runtime (see MARIO_* / docker-compose volumes).
# Default: Kokoro Spanish female voice ef_dora.
#
# Dependencies install from uv.lock, not from floating resolution: Mario's
# output is byte-deterministic audio, and the TTS numerics depend on transitive
# pins (onnxruntime, numpy, soundfile) that pyproject's direct pins do not
# cover. --frozen fails the build instead of silently resolving anything new.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock LICENSE /app/
COPY docs/ /app/docs/
COPY src/ /app/src/
COPY presets/ /app/presets/

# Install runtime dependencies (Kokoro backend).
RUN uv sync --frozen --no-dev \
 && groupadd -r -g 10001 mario \
 && useradd -r -u 10001 -g mario -d /home/mario -m -s /usr/sbin/nologin mario \
 && mkdir -p /music /data/host /home/mario \
 && chown -R mario:mario /home/mario /music /data/host \
 && chmod -R a+rX /app

ENV PATH="/app/.venv/bin:$PATH" \
    HOME=/home/mario

# Runtime user is typically overridden by compose (${MARIO_UID}:${MARIO_GID}) to
# align bind-mount ownership; keep image non-root by default.
USER mario

VOLUME ["/music", "/data/host"]

ENTRYPOINT ["mario"]
CMD ["generate", "--music-dir", "/music", "--host-dir", "/data/host"]
